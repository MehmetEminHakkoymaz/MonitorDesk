<Application x:Class="MonitorDesk.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Application.Resources>
 <SolidColorBrush x:Key="Page" Color="#0D111B"/><SolidColorBrush x:Key="Card" Color="#171E2D"/>
 <SolidColorBrush x:Key="Ink" Color="#F1F5FC"/><SolidColorBrush x:Key="Muted" Color="#A2AEC5"/>
 <SolidColorBrush x:Key="Line" Color="#2B364C"/><SolidColorBrush x:Key="Accent" Color="#8BE5CE"/>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Card}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="16,10"/>
  <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Slider"><Setter Property="Margin" Value="0,12,0,4"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="TickFrequency" Value="1"/></Style>
</Application.Resources></Application>
