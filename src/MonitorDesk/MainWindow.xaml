<Window x:Class="MonitorDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MonitorDesk · v0.1.2" Width="1040" Height="780" MinWidth="680" MinHeight="520" Background="{DynamicResource Page}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Grid Margin="32">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel><TextBlock Text="MONITORDESK  /  DISPLAY CONTROL" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Your screens. In balance." FontSize="30" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="A little more comfort, on every display." Foreground="{DynamicResource Muted}"/></StackPanel>
   <Button Content="Switch theme" Click="Theme_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/>
  </Grid>
  <Grid Grid.Row="1" Margin="0,30,0,20">
   <TextBlock x:Name="Summary" Text="Finding your displays…" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" x:Name="Toolbar"><Button Content="Identify screens" Click="Identify_Click" Margin="0,0,10,0"/><Button Content="Refresh" Click="Refresh_Click"/></StackPanel>
  </Grid>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Cards" Margin="0,0,12,0"/></ScrollViewer>
  <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,14,0,0"><TextBlock x:Name="Status" Text="Reading display information. No settings will be changed." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border>
 </Grid>
</Window>
