<Window x:Class="MonitorDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:MonitorDesk" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Monilivo · v0.17.0" Width="1280" Height="920" MinWidth="680" MinHeight="520" Background="{DynamicResource Page}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" Icon="Assets/MonitorDesk.ico">
 <Grid Margin="24,24" MaxWidth="1320">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18">
   <StackPanel><TextBlock Text="Monilivo" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr Key=Tagline}" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel>
   <StackPanel x:Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="{loc:Tr Key=Identify}" Click="Identify_Click" Margin="0,0,8,0"/><Button Content="{loc:Tr Key=Refresh}" Click="Refresh_Click" Margin="0,0,8,0"/><Button x:Name="ThemeButton" Content="{loc:Tr Key=Theme}" Click="Theme_Click" Margin="0,0,8,0"/><Button Content="{loc:Tr Key=Preferences}" Click="Settings_Click"/></StackPanel>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="WorkspaceScroll">
   <StackPanel Margin="0,0,8,0">
    <Grid x:Name="TopSections" Margin="0,0,0,24">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="ArrangementPanel" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,16,0"><ContentControl x:Name="LayoutHost"/></Border>
    <Border x:Name="LightingPanel" Grid.Column="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="20">
     <StackPanel x:Name="ProfilesPanel">
      <TextBlock Text="{loc:Tr Key=LightingProfiles}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
      <UniformGrid x:Name="ProfileButtons" Columns="1"/>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
       <StackPanel>
        <Button x:Name="WarmButton" Content="{loc:Tr Key=EyeComfortOff}" Click="Warm_Click" ToolTip="{loc:Tr Key=WarmTooltip}"/>
        <Slider x:Name="WarmStrength" Minimum="0" Maximum="90" Value="40" SmallChange="1" LargeChange="10" ValueChanged="WarmStrength_Changed" AutomationProperties.Name="{loc:Tr Key=WarmStrength}" ToolTip="{loc:Tr Key=WarmStrength}"/>
        <TextBlock x:Name="WarmValue" Text="{loc:Tr Key=InitialStrength}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </Border>
      <TextBlock x:Name="ProfileStatus" Visibility="Collapsed" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
      <Expander x:Name="ProfileDetails" Header="{loc:Tr Key=MonitorResults}" Visibility="Collapsed" Margin="0,8,0,0" Foreground="{DynamicResource Ink}"><TextBox x:Name="ProfileReport" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" BorderThickness="0" Padding="10" MaxHeight="200" VerticalScrollBarVisibility="Auto"/></Expander>
     </StackPanel>
    </Border>
    </Grid>
    <Grid Margin="0,0,0,12"><TextBlock Text="{loc:Tr Key=DisplaySettings}" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="Summary" Text="{loc:Tr Key=FindingDisplays}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></Grid>
    <WrapPanel x:Name="Cards"/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0"><TextBlock x:Name="Status" Text="{loc:Tr Key=ReadingDisplays}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/></Border>
 </Grid>
</Window>
