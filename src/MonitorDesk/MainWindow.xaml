<Window x:Class="MonitorDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MonitorDesk · v0.6.0" Width="1280" Height="920" MinWidth="680" MinHeight="520" Background="{DynamicResource Page}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Grid Margin="24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18">
   <StackPanel><TextBlock Text="MonitorDesk" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Your workspace, in balance." Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel>
   <StackPanel x:Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Identify" Click="Identify_Click" Margin="0,0,8,0"/><Button Content="Refresh" Click="Refresh_Click" Margin="0,0,8,0"/><Button Content="Theme" Click="Theme_Click"/></StackPanel>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="WorkspaceScroll">
   <StackPanel Margin="0,0,8,0">
    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,20"><ContentControl x:Name="LayoutHost"/></Border>
    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
     <StackPanel x:Name="ProfilesPanel">
      <TextBlock Text="Lighting profiles" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="Apply brightness and contrast to all supported monitors. Values are percentages of each control's range." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"/>
      <WrapPanel x:Name="ProfileButtons"/>
      <TextBlock x:Name="ProfileStatus" Text="Choose a profile to apply it. Unavailable controls are skipped." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
      <Expander x:Name="ProfileDetails" Header="Results by monitor" Visibility="Collapsed" Margin="0,8,0,0" Foreground="{DynamicResource Ink}"><TextBox x:Name="ProfileReport" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" BorderThickness="0" Padding="10" MaxHeight="200" VerticalScrollBarVisibility="Auto"/></Expander>
     </StackPanel>
    </Border>
    <Grid Margin="0,0,0,12"><TextBlock Text="Display settings" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="Summary" Text="Finding displays…" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></Grid>
    <WrapPanel x:Name="Cards"/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0"><TextBlock x:Name="Status" Text="Reading displays…" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/></Border>
 </Grid>
</Window>
